root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ads,adb,gpr}]
indent_size = 3
max_line_length = 79

[*.py]
indent_size = 4

[*.{sh,yml,toml,md}]
indent_size = 2
