# Alire workspace (generated, repo root only — anchored so it does not
# swallow nested config dirs like tests/autobahn/config)
/alire/
/config/

# GNAT build outputs
obj/
lib/
*.ali
*.o
*.cswi
*.adb.std*
*.ads.std*

# Test binaries and build tree
tests/obj/
tests/bin/

# mbedTLS source (downloaded by scripts/fetch_mbedtls.sh)
third_party/

# Scratch area for binding regeneration
scratch/

# Stray top-level review binaries from ad-hoc builds
/review_empty
/review_encoding
/review_urls

# Python bytecode (tests/server/server.py)
__pycache__/
*.pyc

# Self-signed test certs (generated by scripts/generate_cert.sh)
tests/server/certs/

# Editor / OS
*.swp
*~
.DS_Store
tests/.venv
