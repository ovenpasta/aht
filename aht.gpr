library project Aht is

   for Library_Name use "aht";
   for Library_Kind use "static";

   for Languages   use ("Ada", "C");

   type Build_Mode_Kind is ("debug", "release");
   Build_Mode : Build_Mode_Kind := external ("BUILD_MODE", "debug");

   --  TLS backend, from the AHT_TLS_BACKEND environment variable; the
   --  env-var route also reaches the Alire pre-build action
   --  (scripts/fetch_mbedtls.sh, whose default must match this one).
   --  Prefixed because gprbuild externals share one namespace across
   --  the build closure.
   type TLS_Backend_Kind is ("openssl", "mbedtls");
   TLS_Backend : TLS_Backend_Kind := external ("AHT_TLS_BACKEND", "openssl");

   --  Target OS family, not the host: the Windows body is cross-built
   --  from Linux with mingw. Selects the body of AHT.Random.Source
   --  (/dev/urandom on POSIX, BCryptGenRandom on Windows), the
   --  body-less AHT.Mbedtls.Link for the mbedtls backend, and the
   --  triplet-suffixed paths below. An explicit external because GPR
   --  cannot pattern-match Project'Target. Windows is not supported.
   type OS_Kind is ("posix", "windows");
   OS : OS_Kind := external ("AHT_OS", "posix");

   --  Cross toolchain triplet, used only when OS is windows. It names
   --  the object, library and vendored-mbedTLS directories, and
   --  tests/run_tests.sh passes the same string to gprbuild --target.
   --  In the paths because an i686 and an x86-64 mingw build cannot
   --  share objects. Keep the default in lockstep with
   --  scripts/fetch_mbedtls.sh, which checks it against -dumpmachine.
   Cross_Target := external ("AHT_CROSS_TARGET", "x86_64-w64-mingw32");

   --  Whether every exception occurrence carries a traceback (-Es).
   --  On i686 mingw __gnat_backtrace walks the frame-pointer chain and
   --  faults on a raise from a frame without ebp (-E faults the same
   --  way: it is the capture, not the symbolisation), so tracebacks
   --  are off there; POSIX and x86-64 mingw store them.
   --  tests/run_tests.sh picks "none" from the triplet.
   type Traceback_Kind is ("stored", "none");
   Traceback : Traceback_Kind := external ("AHT_TRACEBACK", "stored");

   --  The oldest Windows the C sources may be compiled against. mingw
   --  gates its declarations on _WIN32_WINNT, so a reach for a
   --  Vista-only entry point is a compile error. scripts/fetch_mbedtls.sh
   --  passes the same value to the mbedTLS build. Applied to both
   --  Windows triplets.
   Win32_Winnt := external ("AHT_WIN32_WINNT", "0x0501");

   Win32_Defines := ();

   case OS is
      when "posix" =>
         null;
      when "windows" =>
         Win32_Defines := ("-D_WIN32_WINNT=" & Win32_Winnt);
   end case;

   --  Where the system OpenSSL 3 lives. /usr is right for Linux;
   --  macOS needs the Homebrew prefix (Apple ships no OpenSSL headers):
   --  AHT_OPENSSL_DIR=$(brew --prefix openssl@3)
   Openssl_Dir := external ("AHT_OPENSSL_DIR", "/usr");

   --  Exactly one backend's sources compile: src/aht-transport-tls.ads
   --  has one body per backend directory, with that backend's bindings
   --  and C glue. The mbedtls backend also splits AHT.Mbedtls.Link per
   --  OS (src/tls/mbedtls/os/*/aht-mbedtls-link.ads), since the
   --  vendored library's link line differs per target.
   Tls_Dirs := ();
   case TLS_Backend is
      when "mbedtls" =>
         case OS is
            when "posix" =>
               Tls_Dirs := ("src/tls/mbedtls", "csrc/mbedtls",
                            "src/tls/mbedtls/os/posix");
            when "windows" =>
               Tls_Dirs := ("src/tls/mbedtls", "csrc/mbedtls",
                            "src/tls/mbedtls/os/windows");
         end case;
      when "openssl" =>
         Tls_Dirs := ("src/tls/openssl", "csrc/openssl");
   end case;

   --  One body of src/aht-random-source.ads per OS directory.
   Os_Dirs := ();
   case OS is
      when "posix" =>
         Os_Dirs := ("src/os/posix");
      when "windows" =>
         Os_Dirs := ("src/os/windows");
   end case;

   --  csrc/dns is one file for both platforms: the halves differ only
   --  in which thread API they name, and the refcount handoff is
   --  shared.
   for Source_Dirs use ("src", "csrc/dns") & Tls_Dirs & Os_Dirs;

   --  One object and library directory per mode, backend and target,
   --  so builds of different combinations coexist. The OS is in the
   --  variant only when it is not the default, so POSIX paths keep
   --  their names and the test harness derives its own from
   --  BUILD_MODE and AHT_TLS_BACKEND alone.
   Variant := Build_Mode & "-" & TLS_Backend;
   case OS is
      when "posix" =>
         null;
      when "windows" =>
         Variant := Variant & "-" & Cross_Target;
   end case;
   for Object_Dir  use "obj/" & Variant;
   for Library_Dir use "lib/" & Variant;

   --  Absolute paths: gprbuild runs the compilers from the object dir.
   --  One tree per target, keyed on the triplet like Variant;
   --  scripts/fetch_mbedtls.sh composes the same name with the same
   --  defaults. The version here and VERSION in that script are one
   --  fact stated twice; test_tls_version, which asserts the linked
   --  library's version string, catches a disagreement.
   Mbedtls_Tree := "third_party/mbedtls-3.6.7";
   case OS is
      when "posix" =>
         null;
      when "windows" =>
         Mbedtls_Tree := Mbedtls_Tree & "-" & Cross_Target;
   end case;
   Mbedtls_Lib_Dir := Aht'Project_Dir & Mbedtls_Tree & "/library";
   Mbedtls_Inc_Dir := Aht'Project_Dir & Mbedtls_Tree & "/include";

   package Compiler is
      case Build_Mode is
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-g", "-O0",
               "-gnat2022",
               "-gnata",              -- enable contracts/assertions
               "-gnatwa",             -- all warnings
               "-gnatVa",             -- all validity checks
               "-fstack-check");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-O2", "-gnatn",
               "-gnat2022");
      end case;

      case TLS_Backend is
         when "mbedtls" =>
            --  No mbedTLS -D flags: the macros live in the tree's own
            --  mbedtls_config.h, edited by scripts/fetch_mbedtls.sh,
            --  and this -I points at it so the glue and the archive
            --  agree on MBEDTLS_THREADING_C and the struct sizes it
            --  changes.
            for Default_Switches ("C") use
              ("-O2", "-I" & Mbedtls_Inc_Dir) & Win32_Defines;
         when "openssl" =>
            for Default_Switches ("C") use
              ("-O2", "-I" & Openssl_Dir & "/include") & Win32_Defines;
      end case;
   end Compiler;

   package Binder is
      case Traceback is
         when "stored" =>
            for Default_Switches ("Ada") use ("-Es");
         when "none" =>
            for Default_Switches ("Ada") use ();
      end case;
   end Binder;

   package Linker is
      --  The backend libraries are pulled in by `pragma Linker_Options`
      --  in the backend's root binding package, so they join the link
      --  only when a closure uses TLS; the search path stays here so
      --  link errors surface at the project level.
      case TLS_Backend is
         when "mbedtls" =>
            for Linker_Options use ("-L" & Mbedtls_Lib_Dir);
         when "openssl" =>
            for Linker_Options use ("-L" & Openssl_Dir & "/lib");
      end case;
   end Linker;

end Aht;
