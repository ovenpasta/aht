library project Aht is

   for Library_Name use "aht";
   for Library_Kind use "static";

   for Languages   use ("Ada", "C");
   for Source_Dirs use ("src", "csrc");
   for Object_Dir  use "obj";
   for Library_Dir use "lib";

   type Build_Mode_Kind is ("debug", "release");
   Build_Mode : Build_Mode_Kind := external ("BUILD_MODE", "debug");

   --  Absolute paths: gprbuild runs the compilers from the object dir, so
   --  a project-relative path would not resolve. Aht'Project_Dir is the
   --  absolute project directory and ends with a directory separator.
   Mbedtls_Lib_Dir := Aht'Project_Dir & "third_party/mbedtls-2.28.9/library";
   Mbedtls_Inc_Dir := Aht'Project_Dir & "third_party/mbedtls-2.28.9/include";

   package Compiler is
      case Build_Mode is
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-g", "-O0",
               "-gnat2022",
               "-gnata",              -- enable contracts/assertions
               "-gnatwa",             -- all warnings
               "-gnatVa",             -- all validity checks
               "-fstack-check");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-O2", "-gnatn",
               "-gnat2022");
      end case;

      --  The C glue (csrc/aht_mbedtls_glue.c) needs the mbedTLS headers,
      --  AND it must see the exact same config macros the library was
      --  compiled with — MBEDTLS_THREADING_C adds a mutex member to
      --  several context structs, so a glue translation unit that omits
      --  it computes a smaller sizeof, under-allocates in *_new, and
      --  mbedtls_*_init then writes past the block (heap corruption).
      --  Keep these defines in lockstep with the CFLAGS in
      --  scripts/fetch_mbedtls.sh.
      for Default_Switches ("C") use
        ("-O2", "-I" & Mbedtls_Inc_Dir,
         "-DMBEDTLS_THREADING_C", "-DMBEDTLS_THREADING_PTHREAD");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      --  mbedTLS static libraries are produced by scripts/fetch_mbedtls.sh.
      --  They are consumed by AHT.Transport.TLS via a `pragma Linker_Options`
      --  directive, so listing them here is not strictly required — but
      --  keeping the directory on the library search path lets link-time
      --  errors surface at the project level rather than from inside the
      --  binding unit.
      for Linker_Options use ("-L" & Mbedtls_Lib_Dir);
   end Linker;

end Aht;
