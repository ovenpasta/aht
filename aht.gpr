library project Aht is

   for Library_Name use "aht";
   for Library_Kind use "static";

   for Languages   use ("Ada", "C");

   type Build_Mode_Kind is ("debug", "release");
   Build_Mode : Build_Mode_Kind := external ("BUILD_MODE", "debug");

   --  TLS backend selection. Set via the AHT_TLS_BACKEND environment
   --  variable (or -XAHT_TLS_BACKEND=...): the env-var route is the
   --  supported one, because it also reaches the Alire pre-build action
   --  (scripts/fetch_mbedtls.sh gates itself on it — keep that script's
   --  default in lockstep with this one). Prefixed name on purpose:
   --  gprbuild externals share one namespace across the whole build
   --  closure, and an unqualified TLS_BACKEND could collide with
   --  another crate's.
   type TLS_Backend_Kind is ("openssl", "mbedtls");
   TLS_Backend : TLS_Backend_Kind := external ("AHT_TLS_BACKEND", "openssl");

   --  TARGET OS family -- not the host, and the difference is the
   --  whole point: the Windows body is built from a Linux host with a
   --  mingw toolchain, so a variable named for the host would be
   --  wrong in exactly the case it exists to serve.
   --
   --  Selects the one unit that cannot be written portably,
   --  AHT.Random.Source, which reads the system CSPRNG
   --  (/dev/urandom on POSIX, BCryptGenRandom on Windows).
   --
   --  An explicit external rather than target sniffing, because GPR
   --  cannot pattern-match Project'Target and a wrong guess here is
   --  the kind that fails at link time on someone else's machine.
   --  Defaults to posix, which is what this library is tested on.
   type OS_Kind is ("posix", "windows");
   OS : OS_Kind := external ("AHT_OS", "posix");

   --  Where the system OpenSSL 3 lives. /usr is right for Linux;
   --  macOS needs the Homebrew prefix (Apple ships no OpenSSL headers):
   --  AHT_OPENSSL_DIR=$(brew --prefix openssl@3)
   Openssl_Dir := external ("AHT_OPENSSL_DIR", "/usr");

   --  Exactly one backend's sources compile: the shared spec
   --  src/aht-transport-tls.ads has one body per backend directory,
   --  alongside that backend's bindings and C glue.
   Tls_Dirs := ();
   case TLS_Backend is
      when "mbedtls" =>
         Tls_Dirs := ("src/tls/mbedtls", "csrc/mbedtls");
      when "openssl" =>
         Tls_Dirs := ("src/tls/openssl", "csrc/openssl");
   end case;

   --  Same one-body-per-directory shape as the TLS split above: the
   --  shared spec src/aht-random-source.ads has one body per OS
   --  directory, and exactly one of them compiles.
   Os_Dirs := ();
   case OS is
      when "posix" =>
         Os_Dirs := ("src/os/posix");
      when "windows" =>
         Os_Dirs := ("src/os/windows");
   end case;

   for Source_Dirs use ("src") & Tls_Dirs & Os_Dirs;

   --  Output dirs are per-mode AND per-backend so no combination ever
   --  clobbers another (a release build used to overwrite the debug
   --  .o/.ali/libaht.a in a shared dir, forcing a full rebuild on the
   --  next debug run; backend switches would do the same). Consumers
   --  reach the library through this project, so the suffixed
   --  Library_Dir resolves automatically.
   --  The OS is part of the variant, but only when it is not the
   --  default, so existing POSIX paths keep their names and the test
   --  harness -- which derives its own from BUILD_MODE and
   --  AHT_TLS_BACKEND -- is unaffected.
   --
   --  It has to be in there somehow. AHT_OS changes which body
   --  compiles, so a native and a cross build produce artifacts that
   --  are not interchangeable, and sharing one object directory means
   --  each silently overwrites the other. The earlier justification
   --  for leaving it out -- that such builds cannot share a machine
   --  anyway -- was simply wrong: a mingw toolchain alongside the
   --  native one is exactly how the Windows body was verified, on
   --  this machine, before it was committed.
   Variant := Build_Mode & "-" & TLS_Backend;
   case OS is
      when "posix" =>
         null;
      when "windows" =>
         Variant := Variant & "-windows";
   end case;
   for Object_Dir  use "obj/" & Variant;
   for Library_Dir use "lib/" & Variant;

   --  Absolute paths: gprbuild runs the compilers from the object dir, so
   --  a project-relative path would not resolve. Aht'Project_Dir is the
   --  absolute project directory and ends with a directory separator.
   Mbedtls_Lib_Dir := Aht'Project_Dir & "third_party/mbedtls-2.28.9/library";
   Mbedtls_Inc_Dir := Aht'Project_Dir & "third_party/mbedtls-2.28.9/include";

   package Compiler is
      case Build_Mode is
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-g", "-O0",
               "-gnat2022",
               "-gnata",              -- enable contracts/assertions
               "-gnatwa",             -- all warnings
               "-gnatVa",             -- all validity checks
               "-fstack-check");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-O2", "-gnatn",
               "-gnat2022");
      end case;

      case TLS_Backend is
         when "mbedtls" =>
            --  The C glue (csrc/mbedtls/aht_mbedtls_glue.c) needs the
            --  mbedTLS headers, AND it must see the exact same config
            --  macros the library was compiled with —
            --  MBEDTLS_THREADING_C adds a mutex member to several
            --  context structs, so a glue translation unit that omits
            --  it computes a smaller sizeof, under-allocates in *_new,
            --  and mbedtls_*_init then writes past the block (heap
            --  corruption). Keep these defines in lockstep with the
            --  CFLAGS in scripts/fetch_mbedtls.sh.
            for Default_Switches ("C") use
              ("-O2", "-I" & Mbedtls_Inc_Dir,
               "-DMBEDTLS_THREADING_C", "-DMBEDTLS_THREADING_PTHREAD");
         when "openssl" =>
            for Default_Switches ("C") use
              ("-O2", "-I" & Openssl_Dir & "/include");
      end case;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      --  The backend libraries themselves are pulled in by `pragma
      --  Linker_Options` in the backend's root binding package
      --  (aht-mbedtls.ads / aht-openssl.ads), so they only join the
      --  link when a binary's closure actually uses TLS. Keeping the
      --  search path here lets link-time errors surface at the project
      --  level rather than from inside the binding unit.
      case TLS_Backend is
         when "mbedtls" =>
            for Linker_Options use ("-L" & Mbedtls_Lib_Dir);
         when "openssl" =>
            for Linker_Options use ("-L" & Openssl_Dir & "/lib");
      end case;
   end Linker;

end Aht;
