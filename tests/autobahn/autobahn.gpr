with "../../aht.gpr";

--  Driver for the Autobahn|Testsuite fuzzingserver. Kept out of
--  tests/tests.gpr: it needs an external server on :9001 (see
--  run.sh), and run_tests.sh expects every main to pass unattended.
project Autobahn is

   for Source_Dirs use ("src");
   for Object_Dir  use "obj/" & Aht.Variant;
   for Exec_Dir    use "bin/" & Aht.Variant;

   for Main use ("aht_autobahn.adb");

   package Compiler renames Aht.Compiler;
   package Binder   renames Aht.Binder;

end Autobahn;
