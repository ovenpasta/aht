with "../aht.gpr";

project Tests is

   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";

   for Main use
     ("test_url.adb",
      "test_url_encoding.adb",
      "test_headers.adb",
      "test_tcp.adb",
      "test_log.adb",
      "test_http_io.adb",
      "test_http_wire.adb",
      "test_http_client.adb",
      "test_http_get.adb",
      "test_http_chunked.adb",
      "test_http_post.adb",
      "test_http_auth.adb",
      "test_http_cancel.adb");

   package Compiler renames Aht.Compiler;
   package Binder   renames Aht.Binder;

end Tests;
