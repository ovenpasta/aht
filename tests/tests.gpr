with "../aht.gpr";

project Tests is

   --  Common tests plus the per-backend version smoke test
   --  (test_tls_version has one source per backend directory).
   case Aht.TLS_Backend is
      when "mbedtls" =>
         for Source_Dirs use ("src", "src/mbedtls");
      when "openssl" =>
         for Source_Dirs use ("src", "src/openssl");
   end case;

   for Object_Dir  use "obj/" & Aht.Variant;
   for Exec_Dir    use "bin/" & Aht.Variant;

   for Main use
     ("test_bytes_buffer.adb",
      "test_url.adb",
      "test_url_encoding.adb",
      "test_headers.adb",
      "test_tcp.adb",
      "test_transport_finalize.adb",
      "test_log.adb",
      "test_http_io.adb",
      "test_http_wire.adb",
      "test_http_client.adb",
      "test_http_get.adb",
      "test_http_chunked.adb",
      "test_http_post.adb",
      "test_http_auth.adb",
      "test_http_cancel.adb",
      "test_http_upload.adb",
      "test_http_streaming.adb",
      "test_http_async.adb",
      "test_httpbin.adb",
      "test_ws_send_guard.adb",
      "test_ws_frames.adb",
      "test_ws_utf8.adb",
      "test_ws_handshake.adb",
      "test_ws_echo.adb",
      "test_ws_ping.adb",
      "test_ws_send_closed.adb",
      "test_ws_abort.adb",
      "test_ws_tls.adb",
      "test_tls_version.adb",
      "test_tls.adb",
      "test_tls_retry.adb",
      "test_tls_truncation.adb",
      "test_tls_corrupt.adb",
      "test_tls_concurrent_corrupt.adb",
      "test_tls_bad_handshake.adb",
      "test_tls_ip_host.adb",
      "test_tls_stress.adb",
      "test_tls_keyupdate.adb",
      "test_http_tls.adb",
      "test_tls_timeout.adb");

   package Compiler renames Aht.Compiler;
   package Binder   renames Aht.Binder;

end Tests;
