with "../aht.gpr";

--  Example programs, ordered easy -> hard, one capability each;
--  examples/run_examples.sh builds and runs the ladder against the
--  Python fixtures.
project Examples is

   for Source_Dirs use ("src");
   --  Per-variant output dirs, mirroring aht.gpr.
   for Object_Dir use "obj/" & Aht.Variant;
   for Exec_Dir   use "bin/" & Aht.Variant;

   for Main use
     ("ex_01_get.adb",
      "ex_02_request.adb",
      "ex_03_streaming.adb",
      "ex_04_async_cancel.adb",
      "ex_05_upload.adb",
      "ex_06_ws_echo.adb",
      "ex_07_ws_callbacks.adb",
      "ex_08_wss_subprotocol.adb",
      "ex_09_https.adb");

   package Compiler renames Aht.Compiler;
   package Binder   renames Aht.Binder;

end Examples;
