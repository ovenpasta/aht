with "../aht.gpr";

--  User-facing example programs, ordered easy -> hard. Each main is a
--  self-contained demonstration of one capability of the AHT client;
--  see examples/run_examples.sh to build + run the whole ladder against
--  the bundled Python fixtures.
project Examples is

   for Source_Dirs use ("src");
   --  Per-variant (mode + TLS backend) output dirs, mirroring aht.gpr:
   --  no build combination may clobber another, or the next build in
   --  the other combination is silently stale.
   for Object_Dir use "obj/" & Aht.Variant;
   for Exec_Dir   use "bin/" & Aht.Variant;

   for Main use
     ("ex_01_get.adb",
      "ex_02_request.adb",
      "ex_03_streaming.adb",
      "ex_04_async_cancel.adb",
      "ex_05_upload.adb",
      "ex_06_ws_echo.adb",
      "ex_07_ws_callbacks.adb",
      "ex_08_wss_subprotocol.adb",
      "ex_09_https.adb");

   package Compiler renames Aht.Compiler;
   package Binder   renames Aht.Binder;

end Examples;
